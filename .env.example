# Copier ce fichier en « .env » puis adapter les valeurs à votre instance de l'API.
# Toutes les variables exposées au front DOIVENT commencer par VITE_ (règle de Vite).

# Adresse de base de votre API.
# Exemple : https://api.maboutique.fr/api
VITE_API_BASE_URL=https://votre-api.example.com/api/v1

# Routes REST des exemples génériques. Adaptez-les au contrat de votre API.
VITE_API_ENDPOINT_PRODUCTS=/products
VITE_API_ENDPOINT_ORDERS=/orders
VITE_API_ENDPOINT_CUSTOMERS=/customers

# Active une session locale pour explorer l'interface. Les écrans génériques appellent quand même l'API.
# Utilisez false et un compte réel pour tester l'authentification API.
VITE_DEMO_MODE=false

# Nom de l’application envoyé à votre API lors de la connexion.
VITE_APP_DEVICE_NAME=navigateur-vue

# Nom affiché dans l'en-tête et l'onglet du navigateur
VITE_APP_TITLE=Mon application Vue
